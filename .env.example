# Public OAuth client identifiers; never place client secrets in frontend code.
GOOGLE_WEB_CLIENT_ID=88220152196-ue6q7abumts1jhb9jkf43rqlkd4veegm.apps.googleusercontent.com
# Set to 0 to disable Google sign-in explicitly.
LUNGITUDE_GOOGLE_SIGNIN=1
APPLE_SERVICES_ID=
APPLE_REDIRECT_URI=
# Production only: exact HTTPS origin and Secure cookies.
LUNGITUDE_PUBLIC_ORIGIN=
LUNGITUDE_SECURE_COOKIES=0

# Server-only Places API (New) key, separate from the Google sign-in client ID.
GOOGLE_PLACES_KEY=

# Server-only Claude assistant key. Questions are sent only after explicit consent.
ANTHROPIC_API_KEY=

ANTHROPIC_MODEL=claude-opus-5-5
